{
  "name": "basement-band",
  "version": "0.1.0",
  "private": true,
  "description": "A small, local recording room for playing together",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:native": "node scripts/native.mjs",
    "build:all": "npm run build:native && npm run build:icons && npm run build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:visual": "electron scripts/screenshot.cjs",
    "check": "tsc --noEmit && prettier --check ui desktop scripts tests package.json tsconfig.json vite.config.ts index.html docs README.md",
    "format": "prettier --write ui desktop scripts tests package.json tsconfig.json vite.config.ts index.html docs README.md",
    "package": "npm run build:all && electron-builder --dir",
    "build:icons": "electron scripts/icons.cjs",
    "package:win": "node scripts/package.mjs win",
    "package:mac": "node scripts/package.mjs mac"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "studio.basementband.app",
    "productName": "Basement Band",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "artifacts/native",
        "to": "artifacts/native",
        "filter": [
          "**/*",
          "!**/*.pdb"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Record your instruments into separate audio tracks."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "signAndEditExecutable": true,
      "target": "dir",
      "icon": "desktop/assets/icon.ico"
    },
    "linux": {
      "target": "dir",
      "category": "AudioVideo"
    },
    "icon": "desktop/assets/icon.png",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
