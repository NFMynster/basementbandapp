{
  "name": "basement-band",
  "version": "0.3.0",
  "private": true,
  "description": "A small, local recording room for playing together",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:native": "node scripts/native.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:all": "npm run build:native && npm run build:desktop",
    "start": "node scripts/start.mjs",
    "test": "node scripts/rust-test.mjs && node --test --test-concurrency=1 --test-timeout=120000 --test-force-exit tests/*.test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:visual": "node scripts/screenshot.cjs && node scripts/sound-editors-visual.cjs",
    "lint": "eslint .",
    "check": "tsc --noEmit && tsc -p tsconfig.desktop.json && eslint . && node scripts/rust-test.mjs --check && prettier --check ui desktop scripts tests package.json tsconfig.json tsconfig.desktop.json eslint.config.mjs vite.config.ts index.html docs README.md",
    "format": "prettier --write ui desktop scripts tests package.json tsconfig.json tsconfig.desktop.json eslint.config.mjs vite.config.ts index.html docs README.md",
    "package": "node scripts/package.mjs",
    "build:icons": "node scripts/icons.mjs",
    "package:win": "node scripts/package.mjs win",
    "package:mac": "node scripts/package.mjs mac",
    "release:win": "node scripts/release-win.mjs",
    "release:mac": "node scripts/release-mac.mjs",
    "build:licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.1",
    "vite": "^7.1.0"
  },
  "license": "AGPL-3.0-only"
}
